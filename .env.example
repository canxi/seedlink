# SeedLink 环境变量配置
# 复制此文件为 .env.local 并修改相应值

# 源文件夹路径（PT下载目录）
SOURCE_FOLDER=/downloads

# 目标文件夹路径（媒体库目录）
TARGET_FOLDER=/media

# 智能精简目标文件名（离线处理，仅影响新链接，默认关闭）
SMART_RENAME=false
# 精简标题长度上限（20～80，不含扩展名及重名标识）
RENAME_MAX_LENGTH=60

# 最小视频时长（秒），低于此值不创建硬链接
MIN_DURATION=600

# 自动扫描 Cron 表达式（默认每天凌晨5点）
SCAN_CRON=0 5 * * *

# 数据库路径
DATABASE_URI=sqlite:///data/hardlinks.db

# 调试模式
DEBUG=false
